# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clm_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Application DB Connection (Unprivileged, respects RLS)
DATABASE_URL=postgresql://clm_app:clm_app_secret@localhost:5432/clm_db

# Migration DB Connection (Superuser, executes schema migrations)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clm_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

